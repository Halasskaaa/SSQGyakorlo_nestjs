<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= title %>
    </title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
<h1><%= title %></h1>
    <div class="header">
        <a href="/">Main</a> 
        <a href="/macskak">Macskák</a> 
    </div>
    <table>
        <thead>
            <tr>
                <th>ID</th>
                <th>Plüss neve</th>
            </tr>
        </thead>
        <tbody>
            <% jatekok.forEach(jatek => { %>
                <tr>
                    <td><%= jatek.id %></td>
                    <td><%= jatek.nev %></td>
                </tr>
            <% }) %>
        </tbody>
</body>
</html>